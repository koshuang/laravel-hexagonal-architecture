parameters:

    paths:
        - app
        - Modules

    # The level 8 is the highest level
    level: 8

    # ignoreErrors:
    #    - '#Unsafe usage of new static#'

    excludePaths:
        analyse:
            - ./*/*/Tests/*.php
            - ./_ide_helper.php
            - ./.phpstorm.meta.php (?)
            - ./phpinsights.php

