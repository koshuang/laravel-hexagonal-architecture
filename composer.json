{
    "name": "koshuang/laravel-hexagonal-architecture",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "guzzlehttp/guzzle": "^7.2",
        "laravel/framework": "^13.0",
        "koshuang/laravel-hexagonal": "^0.1",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "nwidart/laravel-modules": "^13.0"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.0",
        "deptrac/deptrac": "^4.7",
        "fakerphp/faker": "^1.9.1",
        "friendsofphp/php-cs-fixer": "^3.95",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.1",
        "nunomaduro/phpinsights": "^2.11",
        "onramplab/onr-phpcs-laravel": "^1.2",
        "pestphp/pest": "^4.0",
        "phpmetrics/phpmetrics": "^2.8",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-mockery": "^2.0",
        "rector/rector": "^2.0",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "Modules/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "phpstan": [
            "tools/scripts/phpstan-all-files.sh"
        ],
        "deptrac": [
            "deptrac analyze"
        ],
        "insights": [
            "phpinsights"
        ],
        "phpcs": [
            "tools/scripts/phpcs-fix.sh all"
        ],
        "phpcs:pr": [
            "tools/scripts/phpcs-fix.sh pr"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "pest"
        ],
        "lint": [
            "composer phpstan",
            "composer deptrac",
            "composer insights",
            "composer phpcs",
            "composer test"
        ],
        "rector": [
            "rector process"
        ],
        "rector:dry-run": [
            "rector process --dry-run"
        ],
        "insights:fix": [
            "phpinsights fix"
        ],
        "refactor": [
            "composer rector",
            "composer deptrac",
            "composer insights:fix",
            "composer phpcs"
        ],
        "refactor:dry-run": [
            "composer rector:dry-run",
            "composer insights"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "merge-plugin": {
            "include": [
                "Modules/*/composer.json"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "wikimedia/composer-merge-plugin": true
        },
        "policy": {
            "audit": {
                "ignore": [
                    "PKSA-m5cs-t1y6-qpcs",
                    "PKSA-3r5d-mb8f-1qw9",
                    "PKSA-mdq4-51ck-6kdq",
                    "PKSA-8qx3-n5y5-vvnd",
                    "PKSA-q46n-4fdk-zjr4",
                    "PKSA-qzrn-rnz3-85w1",
                    "PKSA-w7xr-vk7n-rstm"
                ]
            }
        }
    },
    "prefer-stable": true
}
